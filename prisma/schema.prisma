generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Mirrors a row in Supabase's auth.users table (id is the Supabase Auth user id).
model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at")

  ownedTrips     Trip[]           @relation("TripOwner")
  memberships    TripMembership[]
  personalLists  PackingList[]
  addedItems     PackingItem[]

  @@map("profiles")
}

model Trip {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  ownerId    String    @map("owner_id") @db.Uuid
  owner      Profile   @relation("TripOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  numCyclists Int      @default(1) @map("num_cyclists")
  startDate  DateTime? @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date
  numDays    Int?      @map("num_days")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  memberships TripMembership[]
  routes      Route[]
  packingLists PackingList[]

  @@map("trips")
}

enum RouteSource {
  imported_gpx
  point_to_point
  distance_target
}

// geojson stores a GeoJSON LineString (or MultiLineString for multiple merged tracks).
// Using a plain Json column rather than a native PostGIS geometry column for now — M1
// only needs to render the route, not run spatial queries. Revisit as a PostGIS geometry
// (see plan risk notes on Prisma + PostGIS) once M2/M6 need nearest-point/bounding-box
// queries; GeoJSON round-trips cleanly to that at that point.
model Route {
  id                String      @id @default(uuid()) @db.Uuid
  tripId            String      @map("trip_id") @db.Uuid
  trip              Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  source            RouteSource
  isActive          Boolean     @default(true) @map("is_active")
  geojson           Json
  totalDistanceKm   Float       @map("total_distance_km")
  elevationGainM    Float?      @map("elevation_gain_m")
  elevationProfile  Json?       @map("elevation_profile")
  createdAt         DateTime    @default(now()) @map("created_at")

  gpxSources GpxSource[]

  @@map("routes")
}

model GpxSource {
  id               String   @id @default(uuid()) @db.Uuid
  routeId          String   @map("route_id") @db.Uuid
  route            Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  originalFilename String   @map("original_filename")
  storageUrl       String   @map("storage_url")
  uploadedAt       DateTime @default(now()) @map("uploaded_at")

  @@map("gpx_sources")
}

enum MembershipRole {
  owner
  editor
  viewer
}

enum MembershipStatus {
  pending
  accepted
}

model TripMembership {
  id            String            @id @default(uuid()) @db.Uuid
  tripId        String            @map("trip_id") @db.Uuid
  trip          Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId        String?           @map("user_id") @db.Uuid
  user          Profile?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedEmail  String?           @map("invited_email")
  role          MembershipRole    @default(editor)
  status        MembershipStatus  @default(pending)
  createdAt     DateTime          @default(now()) @map("created_at")

  @@unique([tripId, userId])
  @@map("trip_memberships")
}

enum PackingListScope {
  shared
  personal
}

// One "shared" list per trip (ownerUserId null), plus one "personal" list per
// member (ownerUserId set) — lazily created the first time a user opens the
// packing page for a trip, rather than at trip-creation time.
model PackingList {
  id          String           @id @default(uuid()) @db.Uuid
  tripId      String           @map("trip_id") @db.Uuid
  trip        Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  scope       PackingListScope
  ownerUserId String?          @map("owner_user_id") @db.Uuid
  owner       Profile?         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now()) @map("created_at")

  categories PackingCategory[]

  @@unique([tripId, scope, ownerUserId])
  @@map("packing_lists")
}

model PackingCategory {
  id            String      @id @default(uuid()) @db.Uuid
  packingListId String      @map("packing_list_id") @db.Uuid
  packingList   PackingList @relation(fields: [packingListId], references: [id], onDelete: Cascade)
  name          String
  orderIndex    Int         @default(0) @map("order_index")

  items PackingItem[]

  @@map("packing_categories")
}

model PackingItem {
  id               String          @id @default(uuid()) @db.Uuid
  categoryId       String          @map("category_id") @db.Uuid
  category         PackingCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name             String
  quantity         Int             @default(1)
  isChecked        Boolean         @default(false) @map("is_checked")
  // Reserved for M5 (smart suggestions) — always false/null until then.
  isSuggested      Boolean         @default(false) @map("is_suggested")
  suggestionReason String?         @map("suggestion_reason")
  addedByUserId    String?         @map("added_by_user_id") @db.Uuid
  addedBy          Profile?        @relation(fields: [addedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now()) @map("created_at")

  @@map("packing_items")
}
